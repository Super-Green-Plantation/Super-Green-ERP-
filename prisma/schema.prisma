generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model ProposalNumberSequence {
  id            Int      @id
  currentNumber Int
  updatedAt     DateTime @updatedAt
}

model Branch {
  name                      String
  location                  String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  id                        Int                         @id @default(autoincrement())
  status                    Status                      @default(Active)
  parentId                  Int?
  zoneId                    Int?
  code                      String                      @default("")
  ActivityLog               ActivityLog[]
  parent                    Branch?                     @relation("BranchHierarchy", fields: [parentId], references: [id])
  children                  Branch[]                    @relation("BranchHierarchy")
  zone                      Zone?                       @relation(fields: [zoneId], references: [id])
  client                    Client[]
  commission                Commission[]
  InventoryItem             InventoryItem[]
  investments               Investment[]
  members                   MemberBranch[]
  monthlyProposals          MonthlyProposal[]
  MonthlyProposalCommission MonthlyProposalCommission[]
}

model Zone {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branches  Branch[]
  members   MemberZone[]
}

model Position {
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  id                 Int              @id @default(autoincrement())
  title              Title
  rank               Int              @unique
  isManagement       Boolean          @default(false)
  isProbation        Boolean          @default(false)
  type               PositionType     @default(PROBATION)
  targetBudgetAmount Float            @default(0)
  orc                CommissionRate?
  members            Member[]
  salary             PositionSalary?
  positionTargets    PositionTarget[]
}

model CommissionRate {
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  id               Int      @id @default(autoincrement())
  positionId       Int      @unique
  rateNonPermanent Float    @default(0)
  ratePermanent    Float    @default(0)
  position         Position @relation(fields: [positionId], references: [id])
}

model Member {
  totalCommission                                   Float?
  createdAt                                         DateTime                    @default(now())
  updatedAt                                         DateTime?
  id                                                Int                         @id @default(autoincrement())
  positionId                                        Int
  empNo                                             String                      @unique
  email                                             String?                     @unique
  phone                                             String?
  userId                                            String?                     @unique @db.Uuid
  accNo                                             String?
  address                                           String?
  appointmentLetter                                 String?
  bank                                              String?
  bankBranch                                        String?
  civilStatus                                       String?
  confirmation                                      String?
  dateOfJoin                                        DateTime?
  dob                                               DateTime?
  gender                                            String?
  nameWithInitials                                  String?
  nic                                               String?
  remark                                            String?
  probationStartDate                                String?
  profilePic                                        String?
  status                                            EmployeeStatus              @default(PROBATION)
  epfNo                                             String?
  phone2                                            String?
  lastClientRegisteredAt                            DateTime?
  reportingPersons                                  String[]
  etfNo                                             String?
  isActive                                          Boolean                     @default(true)
  channel                                           Channel                     @default(Chanel_01)
  recruitedById                                     Int?
  approvalStatus                                    ApprovalStatus              @default(PENDING)
  reviewNote                                        String?
  reviewedAt                                        DateTime?
  reviewedBy                                        String?
  submittedAt                                       DateTime                    @default(now())
  autoDeactivatedAt                                 DateTime?                   @db.Timestamp(6)
  lastInvestmentAt                                  DateTime?                   @db.Timestamp(6)
  payrollCategory                                   PayrollCategory?
  activityLog                                       ActivityLog[]
  clientsAsAGM                                      Client[]                    @relation("ClientAGM")
  clientsAsBM                                       Client[]                    @relation("ClientBM")
  clientsAsCCO                                      Client[]                    @relation("ClientCCO")
  createdClients                                    Client[]                    @relation("CreatedByMember")
  clientsAsFA                                       Client[]                    @relation("ClientFA")
  clientsAsFM                                       Client[]                    @relation("ClientFM")
  clients                                           Client[]
  clientsAsRM                                       Client[]                    @relation("ClientRM")
  clientsAsZM                                       Client[]                    @relation("ClientZM")
  commissions                                       Commission[]
  HoPayrollConfig                                   HoPayrollConfig?
  advisorInvestments                                Investment[]                @relation("AdvisorInvestments")
  investmentsAsAGM                                  Investment[]                @relation("InvestmentAGM")
  investmentsAsBM                                   Investment[]                @relation("InvestmentBM")
  investmentsAsCCO                                  Investment[]                @relation("InvestmentCCO")
  investments                                       Investment[]                @relation("InvestmentCreatedBy")
  investmentsAsFA                                   Investment[]                @relation("InvestmentFA")
  investmentsAsFM                                   Investment[]                @relation("InvestmentFM")
  investmentsAsRM                                   Investment[]                @relation("InvestmentRM")
  investmentsAsZM                                   Investment[]                @relation("InvestmentZM")
  ManagementBaseSalary                              ManagementBaseSalary?
  ManagementSalary                                  ManagementSalary[]
  position                                          Position                    @relation(fields: [positionId], references: [id])
  recruitedBy                                       Member?                     @relation("RecruitedBy", fields: [recruitedById], references: [id])
  recruits                                          Member[]                    @relation("RecruitedBy")
  user                                              User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches                                          MemberBranch[]
  zones                                             MemberZone[]
  monthlyActivations                                MonthlyActivation[]
  monthlyEvaluations                                MonthlyEvaluation[]
  monthlyPayrolls                                   MonthlyPayroll[]
  MonthlyProposal_MonthlyProposal_advisorIdToMember MonthlyProposal[]           @relation("MonthlyProposal_advisorIdToMember")
  monthlyProposalsAsBM                              MonthlyProposal[]           @relation("MPBM")
  monthlyProposalsCreated                           MonthlyProposal[]           @relation("MPCreatedBy")
  monthlyProposalsAsFA                              MonthlyProposal[]           @relation("MPFA")
  monthlyProposalsAsFM                              MonthlyProposal[]           @relation("MPFM")
  monthlyProposalsAsRM                              MonthlyProposal[]           @relation("MPRM")
  monthlyProposalsAsZM                              MonthlyProposal[]           @relation("MPZM")
  MonthlyProposalCommission                         MonthlyProposalCommission[]
  MonthlyProposalPayment                            MonthlyProposalPayment[]
  PayrollRecord                                     PayrollRecord[]
  SalaryAdvances                                    SalaryAdvance[]
}

model MemberBranch {
  id        Int     @id @default(autoincrement())
  memberId  Int
  branchId  Int
  isPrimary Boolean @default(false)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, branchId])
}

model MemberZone {
  id       Int    @id @default(autoincrement())
  memberId Int
  zoneId   Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([memberId, zoneId])
}

model PositionSalary {
  id                          Int      @id @default(autoincrement())
  positionId                  Int      @unique
  monthlyTarget               Float
  incentiveAmount             Float
  allowanceAmount             Float
  commRateLow                 Float
  commRateHigh                Float
  commThreshold               Float    @default(500000)
  epfEmployee                 Float    @default(0.08)
  epfEmployer                 Float    @default(0.12)
  etfEmployer                 Float    @default(0.03)
  allowanceThresholdPermanent Float    @default(1.0)
  allowanceThresholdProbation Float    @default(0.75)
  basicSalaryPermanent        Float    @default(0)
  basicSalaryProbation        Float    @default(0)
  incentivePartialAmount      Float    @default(0)
  incentivePartialThreshold   Float    @default(0.75)
  minActiveAdvisors           Int      @default(0)
  minActiveBMs                Int      @default(0)
  minActiveFMs                Int      @default(0)
  teamActiveAmount            Float    @default(0)
  teamActiveThresholdPct      Float    @default(0)
  vehicleAmount               Float    @default(0)
  vehicleThresholdPct         Float    @default(0)
  position                    Position @relation(fields: [positionId], references: [id])
}

model PositionTarget {
  id                      Int      @id @default(autoincrement())
  positionId              Int
  periodNumber            Int
  monthNumber             Int
  targetAmount            Float
  bonusAmount             Float
  excessRate              Float    @default(0)
  partialBonus            Float    @default(0)
  bonusThresholdPct       Float    @default(1.0)
  minActiveAdvisors       Int      @default(0)
  minActiveBMs            Int      @default(0)
  minActiveFMs            Int      @default(0)
  teamActiveAmount        Float    @default(0)
  teamActiveThresholdPct  Float    @default(0)
  vehicleAmount           Float    @default(0)
  vehicleThresholdPct     Float    @default(0)
  after6MonthTarget       Float    @default(0)
  after6MonthIncentivePct Float    @default(0)
  partialThresholdPct     Float    @default(0)
  position                Position @relation(fields: [positionId], references: [id])

  @@unique([positionId, periodNumber, monthNumber])
}

model MonthlyPayroll {
  id                        Int      @id @default(autoincrement())
  memberId                  Int
  year                      Int
  month                     Int
  volumeAchieved            Float    @default(0)
  monthlyTarget             Float
  incentiveEarned           Float    @default(0)
  allowanceEarned           Float    @default(0)
  orcEarned                 Float    @default(0)
  commissionEarned          Float    @default(0)
  epfDeduction              Float    @default(0)
  epfEmployer               Float    @default(0)
  etfEmployer               Float    @default(0)
  incentiveHit              Boolean  @default(false)
  allowanceHit              Boolean  @default(false)
  grossPay                  Float    @default(0)
  netPay                    Float    @default(0)
  createdAt                 DateTime @default(now())
  basicSalaryPermanent      Float    @default(0)
  activationAllowanceEarned Float    @default(0)
  advanceDeducted           Float    @default(0)
  attendanceAllowance       Float    @default(0)
  channelOperation          Float    @default(0)
  excessCommission          Float    @default(0)
  excessEarned              Float    @default(0)
  festivalAdvance           Float    @default(0)
  fixedAllowance            Float    @default(0)
  fuelAllowance             Float    @default(0)
  incentivePartialEarned    Float    @default(0)
  incentivePartialHit       Boolean  @default(false)
  loanInstalments           Float    @default(0)
  merchandiseDeduction      Float    @default(0)
  payrollCategory           String   @default("MARKETING")
  targetBudgetSalary        Float    @default(0)
  teamActiveEarned          Float    @default(0)
  teamActiveHit             Boolean  @default(false)
  tenureMonthCount          Int      @default(1)
  vehicleEarned             Float    @default(0)
  vehicleHit                Boolean  @default(false)
  member                    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, year, month])
}

/// Standing allowance configuration for a Head Office / Management member.
/// One row per member, updated via the HO Payroll Config page.
/// ManagementBaseSalary is kept in sync with basicSalary here for backward compat.
model HoPayrollConfig {
  id                  Int      @id @default(autoincrement())
  memberId            Int      @unique
  basicSalary         Decimal  @default(0) @db.Decimal(12, 2)
  fixedAllowance      Decimal  @default(0) @db.Decimal(12, 2)
  vehicleAllowance    Decimal  @default(0) @db.Decimal(12, 2)
  fuelAllowance       Decimal  @default(0) @db.Decimal(12, 2)
  channelOperation    Decimal  @default(0) @db.Decimal(12, 2)
  attendanceAllowance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  member              Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Legacy single-field salary store — kept for backward compat.
/// Always kept in sync with HoPayrollConfig.basicSalary.
model ManagementBaseSalary {
  id         Int      @id @default(autoincrement())
  memberId   Int      @unique
  baseSalary Decimal
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id])
}

/// Committed HO payroll record — one row per member per month.
/// Stores the full earnings + deductions snapshot at run time.
model ManagementSalary {
  id                       Int       @id @default(autoincrement())
  memberId                 Int
  month                    DateTime
  baseSalary               Decimal
  personalCommissionEarned Decimal   @default(0)
  orcEarned                Decimal   @default(0)
  advanceDeduction         Decimal   @default(0)
  epfDeduction             Decimal   @default(0)
  grossPay                 Decimal
  netPay                   Decimal
  status                   String    @default("PENDING")
  paidAt                   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  attendanceAllowance      Decimal   @default(0) @db.Decimal(12, 2)
  channelOperation         Decimal   @default(0) @db.Decimal(12, 2)
  epfEmployer              Decimal   @default(0) @db.Decimal(12, 2)
  etfEmployer              Decimal   @default(0) @db.Decimal(12, 2)
  festivalAdvance          Decimal   @default(0) @db.Decimal(12, 2)
  fixedAllowance           Decimal   @default(0) @db.Decimal(12, 2)
  fuelAllowance            Decimal   @default(0) @db.Decimal(12, 2)
  leavesTaken              Float     @default(0)
  loanInstalments          Decimal   @default(0) @db.Decimal(12, 2)
  merchandiseDeduction     Decimal   @default(0) @db.Decimal(12, 2)
  vehicleAllowance         Decimal   @default(0) @db.Decimal(12, 2)
  personalIncentive        Decimal   @default(0)
  volumeAchieved           Decimal   @default(0) @db.Decimal(15, 2)
  monthlyTarget            Decimal   @default(0) @db.Decimal(15, 2)
  achievementPct           Decimal   @default(0) @db.Decimal(6, 4)
  basicSalaryHit           Boolean   @default(false)
  incentive75Earned        Decimal   @default(0) @db.Decimal(12, 2)
  incentive75Hit           Boolean   @default(false)
  incentive100Earned       Decimal   @default(0) @db.Decimal(12, 2)
  incentive100Hit          Boolean   @default(false)
  vehicleFuelEarned        Decimal   @default(0) @db.Decimal(12, 2)
  vehicleFuelHit           Boolean   @default(false)
  member                   Member    @relation(fields: [memberId], references: [id])

  @@unique([memberId, month])
}

model PayrollRecord {
  id              String                  @id @default(uuid())
  employeeId      Int
  month           DateTime
  category        PayrollCategory
  status          PayrollStatus           @default(DRAFT)
  totalEarnings   Decimal                 @default(0.0) @db.Decimal(12, 2)
  totalDeductions Decimal                 @default(0.0) @db.Decimal(12, 2)
  netPay          Decimal                 @default(0.0) @db.Decimal(12, 2)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  hoDetail        HoPayrollDetail?
  mktDetail       MarketingPayrollDetail?
  employee        Member                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
}

model HoPayrollDetail {
  id                       String        @id @default(uuid())
  payrollRecordId          String        @unique
  basicSalary              Decimal       @default(0.0) @db.Decimal(12, 2)
  fixedAllowance           Decimal       @default(0.0) @db.Decimal(12, 2)
  vehicleAllowance         Decimal       @default(0.0) @db.Decimal(12, 2)
  fuelAllowance            Decimal       @default(0.0) @db.Decimal(12, 2)
  channelOperation         Decimal       @default(0.0) @db.Decimal(12, 2)
  incentive                Decimal       @default(0.0) @db.Decimal(12, 2)
  attendanceAllowance      Decimal       @default(0.0) @db.Decimal(12, 2)
  orcAmount                Decimal       @default(0.0) @db.Decimal(12, 2)
  personalCommissionEarned Decimal       @default(0.0) @db.Decimal(12, 2)
  hoLeavesTaken            Float         @default(0.0)
  loanInstalments          Decimal       @default(0.0) @db.Decimal(12, 2)
  festivalAdvance          Decimal       @default(0.0) @db.Decimal(12, 2)
  merchandiseDeduction     Decimal       @default(0.0) @db.Decimal(12, 2)
  epfEmployee              Decimal       @default(0.0) @db.Decimal(12, 2)
  epfEmployer              Decimal       @default(0.0) @db.Decimal(12, 2)
  etfEmployer              Decimal       @default(0.0) @db.Decimal(12, 2)
  payrollRecord            PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
}

model MarketingPayrollDetail {
  id                       String        @id @default(uuid())
  payrollRecordId          String        @unique
  targetAmount             Decimal       @db.Decimal(12, 2)
  achievedAmount           Decimal       @db.Decimal(12, 2)
  achievementPct           Float
  tenureMonthCount         Int
  targetBudgetSalary       Decimal       @default(0.0) @db.Decimal(12, 2)
  basicIncentive           Decimal       @default(0.0) @db.Decimal(12, 2)
  excessCommission         Decimal       @default(0.0) @db.Decimal(12, 2)
  vehicleEarned            Decimal       @default(0.0) @db.Decimal(12, 2)
  teamActiveEarned         Decimal       @default(0.0) @db.Decimal(12, 2)
  otherSalesCommission     Decimal       @default(0.0) @db.Decimal(12, 2)
  orcEarned                Decimal       @default(0.0) @db.Decimal(12, 2)
  personalCommissionEarned Decimal       @default(0.0) @db.Decimal(12, 2)
  payrollRecord            PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
}

model SalaryAdvance {
  id                Int                @id @default(autoincrement())
  memberId          Int
  type              AdvanceType
  totalAmount       Float
  installments      Int
  installmentAmount Float
  remainingAmount   Float
  issuedYear        Int
  issuedMonth       Int
  note              String?
  createdAt         DateTime           @default(now())
  deductions        AdvanceDeduction[]
  member            Member             @relation(fields: [memberId], references: [id])
}

model AdvanceDeduction {
  id              Int           @id @default(autoincrement())
  salaryAdvanceId Int
  year            Int
  month           Int
  amountDeducted  Float
  createdAt       DateTime      @default(now())
  salaryAdvance   SalaryAdvance @relation(fields: [salaryAdvanceId], references: [id])

  @@unique([salaryAdvanceId, year, month])
}

model FinancialPlan {
  id          Int          @id @default(autoincrement())
  name        String
  duration    Int
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  status      Status       @default(Active)
  investment  Float?
  rate        Float[]
  investments Investment[]
}

model Investment {
  id                   Int            @id @default(autoincrement())
  investmentDate       DateTime
  amount               Float
  clientId             Int
  planId               Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  advisorId            Int?
  commissionsProcessed Boolean        @default(false)
  refNumber            String?
  branchId             Int
  beneficiaryId        Int?
  nomineeId            Int?
  isMatured            Boolean        @default(false)
  maturityDate         DateTime?
  maturityNotified     Boolean        @default(false)
  monthlyHarvest       Float?
  totalHarvest         Float?
  proposalFormNo       String?        @unique(where: raw("(\"proposalFormNo\" IS NOT NULL)"))
  proposal             String?
  agreement            String?
  paymentSlip          String?
  investmentRates      Float[]        @default([])
  status               InvStatus      @default(Active)
  agmId                Int?
  bmId                 Int?
  ccoId                Int?
  faId                 Int?
  fmId                 Int?
  rmId                 Int?
  zmId                 Int?
  renewedFromId        Int?
  approvalStatus       ApprovalStatus @default(PENDING)
  reviewNote           String?
  reviewedAt           DateTime?
  reviewedBy           String?
  submittedAt          DateTime       @default(now())
  createdById          Int?
  renewalCreditedAt    DateTime?
  commission           Commission[]
  advisor              Member?        @relation("AdvisorInvestments", fields: [advisorId], references: [id])
  agm                  Member?        @relation("InvestmentAGM", fields: [agmId], references: [id])
  beneficiary          Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  bm                   Member?        @relation("InvestmentBM", fields: [bmId], references: [id])
  branch               Branch         @relation(fields: [branchId], references: [id])
  cco                  Member?        @relation("InvestmentCCO", fields: [ccoId], references: [id])
  client               Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy            Member?        @relation("InvestmentCreatedBy", fields: [createdById], references: [id])
  fa                   Member?        @relation("InvestmentFA", fields: [faId], references: [id])
  fm                   Member?        @relation("InvestmentFM", fields: [fmId], references: [id])
  nominee              Nominee?       @relation(fields: [nomineeId], references: [id])
  plan                 FinancialPlan? @relation(fields: [planId], references: [id])
  renewedFrom          Investment?    @relation("RenewalChain", fields: [renewedFromId], references: [id])
  renewals             Investment[]   @relation("RenewalChain")
  rm                   Member?        @relation("InvestmentRM", fields: [rmId], references: [id])
  zm                   Member?        @relation("InvestmentZM", fields: [zmId], references: [id])
  profit               Profit?
}

model Client {
  id                    Int                     @id @default(autoincrement())
  email                 String?                 @unique
  address               String
  branchId              Int
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  dateOfBirth           DateTime?
  drivingLicense        String?                 @unique
  fullName              String
  nic                   String?                 @unique
  occupation            String?
  passportNo            String?                 @unique
  phoneLand             String?
  phoneMobile           String?
  status                Status                  @default(Active)
  idBack                String?
  idFront               String?
  signature             String?
  memberId              Int?
  createdById           Int?
  agmId                 Int?
  bmId                  Int?
  ccoId                 Int?
  faId                  Int?
  fmId                  Int?
  rmId                  Int?
  zmId                  Int?
  approvalStatus        ApprovalStatus          @default(PENDING)
  reviewNote            String?
  reviewedAt            DateTime?
  reviewedBy            String?
  submittedAt           DateTime                @default(now())
  beneficiaries         Beneficiary[]
  agm                   Member?                 @relation("ClientAGM", fields: [agmId], references: [id])
  bm                    Member?                 @relation("ClientBM", fields: [bmId], references: [id])
  branch                Branch                  @relation(fields: [branchId], references: [id])
  cco                   Member?                 @relation("ClientCCO", fields: [ccoId], references: [id])
  createdBy             Member?                 @relation("CreatedByMember", fields: [createdById], references: [id])
  fa                    Member?                 @relation("ClientFA", fields: [faId], references: [id])
  fm                    Member?                 @relation("ClientFM", fields: [fmId], references: [id])
  member                Member?                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rm                    Member?                 @relation("ClientRM", fields: [rmId], references: [id])
  zm                    Member?                 @relation("ClientZM", fields: [zmId], references: [id])
  ClientDocumentRequest ClientDocumentRequest[]
  investments           Investment[]
  monthlyProposals      MonthlyProposal[]
  nominees              Nominee[]
}

model Beneficiary {
  id               Int          @id @default(autoincrement())
  fullName         String
  nic              String?
  phone            String
  bankName         String
  bankBranch       String
  accountNo        String
  relationship     String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  clientId         Int
  bankBookPhotoUrl String?
  idCopyUrl        String?
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  investments      Investment[]
}

model Nominee {
  id               Int          @id @default(autoincrement())
  fullName         String
  permanentAddress String
  postalAddress    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  clientId         Int
  nic              String?
  idCopyUrl        String?
  investments      Investment[]
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Commission {
  id           Int            @id @default(autoincrement())
  investmentId Int?
  memberEmpNo  String
  amount       Float
  type         CommissionType
  createdAt    DateTime       @default(now())
  refNumber    String?        @unique
  branchId     Int
  month        Int
  year         Int
  Branch       Branch         @relation(fields: [branchId], references: [id])
  investment   Investment?    @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [memberEmpNo], references: [empNo], onDelete: Cascade)

  @@index([investmentId])
  @@index([memberEmpNo])
  @@index([year, month, branchId, type])
}

model Profit {
  id               Int        @id @default(autoincrement())
  investmentId     Int        @unique
  investmentAmount Float      @default(0)
  commissionPayout Float      @default(0)
  totalProfit      Float      @default(0)
  investment       Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model MonthlyEvaluation {
  id             Int      @id @default(autoincrement())
  memberId       Int
  year           Int
  month          Int
  periodNumber   Int?
  monthInPeriod  Int?
  volumeAchieved Float
  targetAmount   Float
  bonusEarned    Float    @default(0)
  excessBonus    Float    @default(0)
  targetHit      Boolean  @default(false)
  createdAt      DateTime @default(now())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, year, month])
}

model MonthlyActivation {
  id              Int      @id @default(autoincrement())
  memberId        Int
  year            Int
  month           Int
  activationCount Int      @default(0)
  isActivated     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, year, month])
}

model User {
  role                  Role                    @default(EMPLOYEE)
  branchId              Int?
  status                Boolean                 @default(true)
  email                 String?                 @unique
  name                  String?
  id                    String                  @id @default(uuid()) @db.Uuid
  lastLoginAt           DateTime?               @default(now())
  ClientDocumentRequest ClientDocumentRequest[]
  member                Member?
  quotations            Quotation[]
}

model ClientDocumentRequest {
  id          Int              @id @default(autoincrement())
  clientId    Int
  token       String           @unique
  createdById String           @db.Uuid
  expiresAt   DateTime
  used        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  documents   ClientDocument[]
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ClientDocument {
  id         Int                   @id @default(autoincrement())
  requestId  Int
  idFront    String?
  idBack     String?
  uploadedAt DateTime              @default(now())
  request    ClientDocumentRequest @relation(fields: [requestId], references: [id])
}

model ActivityLog {
  id            Int            @id @default(autoincrement())
  action        ActivityAction
  entity        ActivityEntity
  entityId      Int?
  performedById Int?
  branchId      Int?
  metadata      Json?
  createdAt     DateTime       @default(now())
  branch        Branch?        @relation(fields: [branchId], references: [id])
  performedBy   Member?        @relation(fields: [performedById], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([performedById])
  @@index([branchId])
}

model Quotation {
  id                 String             @id @default(cuid())
  clientName         String
  clientNic          String?
  clientAge          Int?
  planType           QuotationPlanType
  frequency          QuotationFrequency
  duration           Int
  premium            Float
  retirementAge      Int?
  totalInvested      Float
  interestRate       Float
  interestEarned     Float
  maturityAmount     Float
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdByUserId    String             @db.Uuid
  documentCharge     Float              @default(500)
  netInterestEarned  Float
  netMaturityAmount  Float
  pensionPayoutYears Int?
  createdBy          User               @relation(fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
  @@index([planType])
  @@index([createdAt])
}

model InventoryCategory {
  id            Int             @id @default(autoincrement())
  name          String
  abbreviation  String          @unique
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @db.Timestamptz(6)
  InventoryItem InventoryItem[]
}

model InventoryItem {
  id                Int               @id @default(autoincrement())
  branchId          Int?
  categoryId        Int
  name              String
  itemCode          String            @unique
  quantity          Int               @default(1)
  condition         ItemCondition     @default(GOOD)
  notes             String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @db.Timestamptz(6)
  company           InventoryCompany  @default(SGP)
  Branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  InventoryCategory InventoryCategory @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  @@index([branchId])
  @@index([categoryId])
  @@index([company])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([isRead, createdAt(sort: Desc)])
}

model MonthlyProposal {
  id                                       Int                         @id @default(autoincrement())
  planType                                 MonthlyPlanType
  proposalFormNo                           String?                     @unique
  applicantName                            String
  applicantNic                             String?
  applicantDob                             DateTime?                   @db.Date
  applicantAge                             Int?
  applicantAddress                         String?
  applicantPhone                           String?
  applicantEmail                           String?
  gender                                   String?
  maritalStatus                            String?
  applicantBankAccNo                       String?
  applicantBankName                        String?
  childName                                String?
  childDob                                 DateTime?                   @db.Date
  childBirthCertNo                         String?
  childSchool                              String?
  childGrade                               String?
  duration                                 Int
  retirementAge                            Int?
  frequency                                MonthlyFrequency
  premium                                  Float
  totalInvested                            Float
  interestRate                             Float
  interestEarned                           Float
  maturityAmount                           Float
  documentCharge                           Float                       @default(500)
  nomineeName                              String?
  nomineeNic                               String?
  nomineeRelationship                      String?
  nomineePhone                             String?
  agentBankAccNo                           String?
  agentBankName                            String?
  agentBankBranch                          String?
  clientId                                 Int?
  createdById                              Int?
  branchId                                 Int?
  faId                                     Int?
  fmId                                     Int?
  bmId                                     Int?
  rmId                                     Int?
  zmId                                     Int?
  notes                                    String?
  createdAt                                DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                                DateTime                    @default(now()) @db.Timestamptz(6)
  status                                   MonthlyProposalStatus       @default(PENDING)
  activatedAt                              DateTime?                   @db.Timestamptz(6)
  maturityDate                             DateTime?                   @db.Date
  approvalStatus                           ApprovalStatus              @default(PENDING)
  reviewNote                               String?
  reviewedAt                               DateTime?                   @db.Timestamptz(6)
  reviewedBy                               String?
  commissionsProcessed                     Boolean                     @default(false)
  advisorId                                Int?
  Member_MonthlyProposal_advisorIdToMember Member?                     @relation("MonthlyProposal_advisorIdToMember", fields: [advisorId], references: [id], onUpdate: NoAction)
  bm                                       Member?                     @relation("MPBM", fields: [bmId], references: [id])
  branch                                   Branch?                     @relation(fields: [branchId], references: [id])
  client                                   Client?                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy                                Member?                     @relation("MPCreatedBy", fields: [createdById], references: [id])
  fa                                       Member?                     @relation("MPFA", fields: [faId], references: [id])
  fm                                       Member?                     @relation("MPFM", fields: [fmId], references: [id])
  rm                                       Member?                     @relation("MPRM", fields: [rmId], references: [id])
  zm                                       Member?                     @relation("MPZM", fields: [zmId], references: [id])
  MonthlyProposalCommission                MonthlyProposalCommission[]
  MonthlyProposalPayment                   MonthlyProposalPayment[]

  @@index([clientId])
  @@index([createdById])
  @@index([planType])
  @@index([branchId])
  @@index([createdAt])
  @@index([approvalStatus])
}

model MonthlyProposalPayment {
  id                Int             @id @default(autoincrement())
  monthlyProposalId Int
  installmentNo     Int
  dueYear           Int
  dueMonth          Int
  dueDate           DateTime        @db.Date
  paidAmount        Float?
  paidAt            DateTime?       @db.Timestamptz(6)
  receiptNo         String?
  paymentMethod     String?
  notes             String?
  recordedById      Int?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  MonthlyProposal   MonthlyProposal @relation(fields: [monthlyProposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Member            Member?         @relation(fields: [recordedById], references: [id], onUpdate: NoAction)

  @@unique([monthlyProposalId, installmentNo])
  @@index([dueDate])
  @@index([monthlyProposalId], map: "MonthlyProposalPayment_proposalId_idx")
  @@index([monthlyProposalId, dueDate], map: "MonthlyProposalPayment_unpaid_idx", where: raw("(\"paidAmount\" IS NULL)"))
}

model MonthlyProposalCommission {
  id                Int             @id @default(autoincrement())
  monthlyProposalId Int
  memberEmpNo       String
  amount            Float
  type              CommissionType
  refNumber         String?         @unique
  branchId          Int
  month             Int
  year              Int
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  Branch            Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Member            Member          @relation(fields: [memberEmpNo], references: [empNo], onDelete: Cascade, onUpdate: NoAction)
  MonthlyProposal   MonthlyProposal @relation(fields: [monthlyProposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([memberEmpNo])
  @@index([monthlyProposalId], map: "MonthlyProposalCommission_proposalId_idx")
  @@index([year, month])
}

